# Copy this file to config.env and fill in your real values.
# Never commit config.env to GitHub — add it to .gitignore.

# --- Cloudflare R2 (S3-compatible object storage) ---
# Create a bucket in the Cloudflare dashboard > R2, then create an API token
# scoped to that bucket (Object Read & Write).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=harvestchurch-sermons
R2_PUBLIC_BASE_URL=https://media.harvestchurch.org.au
# ^ set this up as a custom domain / public bucket URL in R2 settings

# --- Claude API (for blurb generation) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Whisper transcription ---
# tiny / base / small / medium / large-v3 — bigger = more accurate, slower
WHISPER_MODEL_SIZE=small

# --- Email notification (SMTP — works with Gmail, Outlook, etc.) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@harvestchurch.org.au
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@harvestchurch.org.au
EMAIL_TO=someone@harvestchurch.org.au

# --- Podcast feed metadata (used once when generating feed.xml) ---
PODCAST_TITLE=Harvest Church Sunday Sermons
PODCAST_AUTHOR=Harvest Church
PODCAST_DESCRIPTION=Weekly sermons from Harvest Church, Horsham, Nhill and Stawell.
PODCAST_IMAGE_URL=https://media.harvestchurch.org.au/podcast-cover.jpg
PODCAST_LANGUAGE=en-au
PODCAST_CATEGORY=Religion & Spirituality
PODCAST_EXPLICIT=false
PODCAST_WEBSITE=https://harvestchurch.org.au

# --- SharePoint watcher (for automatic hourly triggering) ---
# From your Azure AD / Entra ID app registration:
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret
# The SharePoint site hostname and path, e.g. for
# https://harvestchurch.sharepoint.com/sites/Media use:
SHAREPOINT_HOSTNAME=harvestchurch.sharepoint.com
SHAREPOINT_SITE_PATH=sites/Media
# The folder within that site's document library to watch, e.g. "Sermons"
# or "Shared Documents/Sermons"
SHAREPOINT_FOLDER_PATH=Sermons
